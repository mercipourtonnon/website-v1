  "$extensions": {
    "com.sovrium.design-system": {
      "principles": [
        "Authenticité — design sincère et transparent, pas de surenchère visuelle ni de promesses exagérées.",
        "Respect et accessibilité — hiérarchie claire, contrastes élevés, espaces généreux pour tou·tes.",
        "Dialogue et ouverture — un ton chaleureux qui invite à l'échange plutôt qu'à la performance.",
        "Simplicité engagée — épuré sans être froid, chaleureux sans être infantilisant ; associatif assumé, loin des codes startup et corporate."
      ],
      "logo": {
        "src": "/logo.svg",
        "alt": "Merci pour ton non",
        "misuse": [
          "Ne jamais recolorer le logo : chaque mot garde sa couleur (pourpre merci, orange pour, mauve ton, cyan non).",
          "Ne jamais l'étirer, le tourner ou lui ajouter des effets.",
          "Le poser uniquement sur fond blanc, fond coloré clair ou fond sombre."
        ]
      },
      "imagery": {
        "principles": [
          "Des photos de vrais ateliers, jamais d'illustrations génériques ; mieux vaut attendre une vraie photo qu'un visuel qui ne nous représente pas.",
          "Les couleurs de marque sont réservées aux éléments stratégiques : logo, titres, boutons, icônes.",
          "Hiérarchie : icônes colorées pour les concepts et actions, photos authentiques pour les personnes."
        ],
        "photography": [
          "Tout visuel est consenti : accord explicite avant d'utiliser une photo de personne identifiable.",
          "Moments spontanés ; mains, gestes, interactions non verbales, expressions sincères.",
          "Lumière naturelle, tons chauds ; proximité, cercles, petits groupes.",
          "Représentation variée des âges, origines, corps et genres.",
          "À éviter : stock lisse, esthétique corporate, postures figées, groupes homogènes, éclairage dur."
        ],
        "iconSet": "lucide",
        "patterns": [
          "Icônes Lucide (trait 2px, 16/24/32–48px) dans les 4 couleurs de marque, pour l'humain et les émotions (heart, ear, shield, hands) — jamais d'emojis, pas de look SaaS.",
          "Cercles qui se chevauchent (rencontres, co-construction) en fond subtil.",
          "Lignes ondulées (fluidité, respect des limites) en filigrane très léger.",
          "Formes géométriques colorées et dégradés clairs (pourpre-light, orange-light, mauve-light, cyan-light) comme fonds ; jamais les teintes vives en fond de section.",
          "Photos en cadre arrondi (rounded-media) avec un cercle de couleur de marque décalé derrière ; jamais en pleine largeur façon stock, jamais de flou ni de blob animé.",
          "Une couleur d'accent par section, choisie selon son rôle (colorRoles) ; fonds de section en blanc ou en une seule teinte -light."
        ]
      },
      "voice": {
        "personality": [
          "Bienveillant mais pas moralisateur.",
          "Pédagogue mais pas condescendant.",
          "Engagé mais pas militant.",
          "Accessible mais pas simpliste."
        ],
        "pronoun": "tu",
        "prefer": [
          "Tutoyer systématiquement et utiliser l'écriture inclusive (·e, ·es).",
          "Vocabulaire : consentement, limites, authenticité, écoute, co-construction ; poser ses limites, accueillir le non, explorer, construire ensemble.",
          "Formuler comme une invitation : « Rejoins-nous pour explorer… », « Cet atelier t'invite à… », « Ensemble, on construit… ».",
          "Privilégier la clarté à l'effet de style."
        ],
        "avoid": [
          "Jargon corporate : solution, optimisation, performance, ROI, levier.",
          "Ton marketing : révolutionnaire, unique, certifiant, garantie, « maximisez votre potentiel », « devenez un expert ».",
          "Vocabulaire thérapeutique : guérison, trauma, diagnostic.",
          "Vouvoiement, ton moralisateur, promesses de résultat."
        ]
      },
      "colorRoles": {
        "pourpre": {
          "usage": "Émotion, authenticité, découverte. Témoignages, sections émotionnelles. Jamais en fond de grande section : utiliser pourpre-light.",
          "pairsWith": "pourpre-light"
        },
        "orange": {
          "usage": "Action, engagement, chaleur. Boutons d'inscription, CTAs principaux, liens actifs — en fond, toujours avec un texte bleu-fonce (8,8:1), jamais blanc (1,8:1). Jamais pour une action contradictoire (annuler ET confirmer).",
          "pairsWith": "orange-light"
        },
        "orange-ink": {
          "usage": "Version texte de l'orange : petits libellés, liens et sur-titres orange sur fond blanc ou clair. L'orange vif n'est jamais du texte (1,8:1).",
          "pairsWith": "orange-light"
        },
        "orange-vif": {
          "usage": "Variante chaude, en opposition au violet. Accent ponctuel uniquement.",
          "pairsWith": "orange-vif-light"
        },
        "mauve": {
          "usage": "Exploration, apprentissage, créativité. Sections pédagogiques, titres secondaires, invitations à la réflexion.",
          "pairsWith": "mauve-light"
        },
        "cyan": {
          "usage": "Validation, calme, ressources. Confirmations, ressources, sections factuelles. Pas en petit texte sur fond blanc (contraste) : utiliser cyan-ink.",
          "pairsWith": "cyan-light"
        },
        "cyan-ink": {
          "usage": "Version texte du cyan : libellés, liens et titres de cartes cyan sur fond blanc ou cyan-light.",
          "pairsWith": "cyan-light"
        },
        "bleu-fonce": {
          "usage": "Texte principal et titres ; remplace le noir partout.",
          "pairsWith": "pourpre-light"
        }
