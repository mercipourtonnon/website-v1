# Sovrium environment variables
# Copy to .env and uncomment what you need. Every variable is OPTIONAL:
# `sovrium start app.yaml` runs zero-config with embedded SQLite, local file
# storage, AI disabled, and eco-friendly defaults.

# ── Core ──────────────────────────────────────────────────────────────
# PORT=3000
# BASE_URL=http://localhost:3000
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname   # omit → SQLite

# ── Auth (only when app.auth is enabled) ──────────────────────────────
# Generate both with: sovrium secret generate
# AUTH_SECRET=
# SOVRIUM_ENCRYPTION_KEY=
# Bootstrap an admin on first start — or run: sovrium admin create <email>
# AUTH_ADMIN_EMAIL=admin@example.com
# AUTH_ADMIN_PASSWORD=

# ── Instance (production: the public https origin) ───────────────────
# BASE_URL=https://mercipourtonnon.fr
# Operator timezone (hourly failure summaries, "today" on pages)
# SOVRIUM_TIMEZONE=Europe/Paris
# Extra recipients of Sovrium's automation-failure alert, comma-separated
# SOVRIUM_NOTIFY_TO=

# ── Email (failure alerts, invitations) ───────────────────────────────
# See: sovrium docs guides-integrations/integrate-email
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# SMTP_FROM=
# SMTP_FROM_NAME=Merci pour ton non

# ── HelloAsso (API v5, OAuth2 client credentials) ─────────────────────
# Declared in app.yaml `env:` — every one is REQUIRED except ADMIN_NOTIFY_EMAIL.
# Development uses the SANDBOX, with its own API client:
#   HELLOASSO_API_BASE_URL=https://api.helloasso-sandbox.com/v5
#   HELLOASSO_TOKEN_URL=https://api.helloasso-sandbox.com/oauth2/token
# Production:
#   HELLOASSO_API_BASE_URL=https://api.helloasso.com/v5
#   HELLOASSO_TOKEN_URL=https://api.helloasso.com/oauth2/token
# The client needs the FormAdministration privilege (ask HelloAsso support).
# HELLOASSO_CLIENT_ID=
# HELLOASSO_CLIENT_SECRET=
# HELLOASSO_ORGANIZATION_SLUG=
# HELLOASSO_API_BASE_URL=
# HELLOASSO_TOKEN_URL=
# Contact email shown on every HelloAsso event
# HELLOASSO_CONTACT_EMAIL=
# Optional: who is emailed when a HelloAsso automation fails
# ADMIN_NOTIFY_EMAIL=
# Optional: secret of the HelloAsso notification URL (generate: sovrium secret generate).
# Once the app is live on Sovrium Cloud, paste in HelloAsso › Mon compte ›
# Intégrations et API › URL de notification:
#   https://mercipourtonnon.fr/api/automations/helloasso-notification/webhook?token=<HELLOASSO_WEBHOOK_TOKEN>
# Without it the webhook ignores every call; the 15-min cron still syncs.
# HELLOASSO_WEBHOOK_TOKEN=

# ── AI (disabled unless AI_PROVIDER is set) ───────────────────────────
# AI_PROVIDER=ollama          # ollama | openai | anthropic | mistral | google
# AI_API_KEY=                 # cloud providers only (not ollama)
# AI_BASE_URL=http://localhost:11434   # ollama endpoint

# ── Storage (auto: local files with SQLite, Postgres bytea otherwise) ──
# STORAGE_PROVIDER=s3         # s3 | local   (omit → auto)
# STORAGE_S3_ENDPOINT=https://s3.amazonaws.com
# STORAGE_S3_BUCKET=my-app-files
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_LOCAL_DIRECTORY=./uploads     # when STORAGE_PROVIDER=local

# ── Ecoconception (frugal by default — override only to opt OUT) ───────
# ECO_PAGE_CACHE=on                       # on | off
# ECO_IMAGE_FORMAT=avif                   # avif | webp | jpeg | png
# ECO_AI_PROVIDER_PRECEDENCE=local-first  # local-first | cloud-first | local-only

# Full reference: https://sovrium.com/docs/configuration
